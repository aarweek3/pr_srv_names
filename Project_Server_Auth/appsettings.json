{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=DbNames;Username=postgres;Password=123"
  },
  "JwtSettings": {
    "SecretKey": "your_strong_secret_key_at_least_32_chars_long_for_security",
    "Issuer": "https://localhost:7233",
    "Audience": "https://localhost:4200",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "FrontendProjectPath": "d:\\_PROGECT\\pr_aurora_admin",
  "Cors": {
    "UseDevelopmentPolicy": true,
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Development": {
    "AllowInsecureCookies": true
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET"
    }
  },
  "IdentitySeed": {
    "Roles": [
      "Admin",
      "User",
      "Moderator"
    ],
    "Users": [
      {
        "Email": "admin@example.com",
        "FullName": "Admin User",
        "Roles": [
          "Admin"
        ]
      }
    ]
  }
}